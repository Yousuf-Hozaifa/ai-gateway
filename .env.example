# Copy to .env (docker compose reads it automatically). Never commit .env.

# Comma-separated API keys clients must send in the X-API-Key header.
# Leave empty ONLY for local development: the gateway then runs without authentication.
GATEWAY_API_KEYS=

RAG_URL=http://localhost:8001
RECEIPTS_URL=http://localhost:8002

RATE_LIMIT_PER_MIN=60      # per client; 0 disables
INJECTION_MODE=block       # block | flag | off
INJECTION_THRESHOLD=0.8    # lower = stricter, more false positives (see README)
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO

# Used by docker-compose.yml
MODEL_ID=your-username/layoutlmv3-cord-receipts
LLM_API_KEY=
